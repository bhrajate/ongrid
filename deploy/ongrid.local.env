# 宿主机原生运行 ongrid 的环境变量（配合 deploy/docker-compose.deps.yml）。
#
# 完整自包含：source 本文件后可直接 `make run-ongrid`，8 个依赖全部指向 localhost。
#
# 用法：
#   docker compose -f deploy/docker-compose.deps.yml -p ongrid-deps up -d
#   set -a; source deploy/ongrid.local.env; set +a
#   make run-ongrid
#
# 说明：本文件是【随仓库提交的示例模板】，全部为占位/dev 默认值，不含真实机密。
# 真实运行请复制一份并填入自己的 key，或直接使用已 gitignore 的 deploy/.env。
# 需你自行填写的项：ONGRID_OPENAI_*（LLM）与 ONGRID_EMBEDDING_*（RAG，可选）。

# ---------------------------------------------------------------------------
# HTTP / metrics 监听（宿主机进程）
# ---------------------------------------------------------------------------
# 前端 vite dev proxy 把 /api 代理到 localhost:8090（见 web/vite.config.ts），
# 故本地开发后端监听 :8090 与之对齐；纯后端调试可改回 :8080。
ONGRID_HTTP_ADDR=:8090
ONGRID_METRICS_ADDR=:9100

# ---------------------------------------------------------------------------
# 数据库：MySQL（deps 栈的 mysql，端口映射到 127.0.0.1:3306）
# ---------------------------------------------------------------------------
ONGRID_DB_DIALECT=mysql
ONGRID_DB_DSN="ongrid:ongrid@tcp(localhost:3307)/ongrid?parseTime=true&charset=utf8mb4&loc=Local"

# ---------------------------------------------------------------------------
# Frontier broker（servicebound 40011，manager 拨入）
# ---------------------------------------------------------------------------
ONGRID_FRONTIER_ADDR=localhost:40011
ONGRID_FRONTIER_SERVICE_NAME=ongrid-manager

# ---------------------------------------------------------------------------
# 引导管理员 / JWT / 机密密钥（本地 dev 占位值）
# ---------------------------------------------------------------------------
ONGRID_ADMIN_EMAIL=admin@ongrid.local
ONGRID_ADMIN_PASSWORD=change-me-on-first-login
ONGRID_JWT_SECRET=local-dev-jwt-secret-change-me-to-a-long-random-string
ONGRID_JWT_ACCESS_TTL=15m
ONGRID_JWT_REFRESH_TTL=168h
# HLD-017 凭据保险库 at-rest 密钥（AES-256-GCM），32+ 随机字符。dev 占位：
ONGRID_SECRET_KEY=local-dev-secret-key-0123456789abcdef

# ---------------------------------------------------------------------------
# LLM（OpenAI 兼容）——★必填：填入你的 API key / base_url / model★
# ---------------------------------------------------------------------------
ONGRID_OPENAI_API_KEY=
ONGRID_OPENAI_MODEL=gpt-4o
ONGRID_OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# Agent kernel
# ---------------------------------------------------------------------------
ONGRID_AGENT_KERNEL=graph
ONGRID_TOOLBAG_DEFERRAL_THRESHOLD=30

# ---------------------------------------------------------------------------
# Prometheus（deps 栈，127.0.0.1:9090，route-prefix=/prometheus/）
# ---------------------------------------------------------------------------
ONGRID_PROM_ENABLED=true
ONGRID_PROM_URL=http://localhost:9090/prometheus
ONGRID_PROM_REMOTE_WRITE_URL=
ONGRID_PROM_QUERY_URL=http://localhost:9090/prometheus

# ---------------------------------------------------------------------------
# Loki 日志查询 / Tempo trace 查询 + OTLP 推送（deps 栈）
# ---------------------------------------------------------------------------
ONGRID_LOG_QUERY_URL=http://localhost:3100
ONGRID_TRACE_QUERY_URL=http://localhost:3200
ONGRID_OTEL_ENDPOINT=localhost:4318

# ---------------------------------------------------------------------------
# 知识库 / RAG：qdrant（deps 栈，127.0.0.1:6333）+ 远程 embedding
#
# 原生跑不便用本地 ONNX，故 embedding 默认走远程 OpenAI 兼容 API。
# 填 ONGRID_EMBEDDING_API_KEY（可与上面 LLM 同一 key，取决于供应商是否提供
# embeddings 接口）。dim 必须与 qdrant collection 一致：
#   text-embedding-3-small → 1536
# 若想改回本地 ONNX：把 provider 设为 local、model=bge-small-zh-v1.5、dim=512，
# 并确保宿主机有 libonnxruntime.so（设 ONNX_PATH）与模型缓存目录。
# ---------------------------------------------------------------------------
ONGRID_QDRANT_URL=http://localhost:6333
ONGRID_EMBEDDING_PROVIDER=openai
ONGRID_EMBEDDING_MODEL=text-embedding-3-small
ONGRID_EMBEDDING_DIM=1536
# base 以 /v1 结尾即可；ongrid 的 embedURL() 会自动补 /embeddings。
# ★勿写成 .../v1/embeddings，否则会被拼成 .../v1/embeddings/v1/embeddings → 404。
ONGRID_EMBEDDING_BASE_URL=
ONGRID_EMBEDDING_API_KEY=

# ---------------------------------------------------------------------------
# Grafana（deps 栈，127.0.0.1:3000，子路径 /grafana）
# manager 首启用下面的 admin 口令自举一个 Service Account token。
# ---------------------------------------------------------------------------
ONGRID_GRAFANA_INTERNAL_URL=http://localhost:3000/grafana
ONGRID_GRAFANA_BOOTSTRAP_USER=admin
ONGRID_GRAFANA_BOOTSTRAP_PASSWORD=admin
ONGRID_GRAFANA_TLS_INSECURE=false

# ---------------------------------------------------------------------------
# SearXNG：★没有 env 开关★——首启会把 http://searxng:8080 写进 system_settings。
# 原生跑请在「设置 → Web 搜索」里把 SearXNG URL 改成 http://localhost:8080，
# 否则 web_search 连不上（deps 栈已把 searxng 暴露到 127.0.0.1:8080）。
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 内置主机告警阈值
# ---------------------------------------------------------------------------
ONGRID_ALERT_ENABLED=true
ONGRID_ALERT_COOLDOWN=10m
ONGRID_ALERT_CPU_PERCENT=90
ONGRID_ALERT_MEM_PERCENT=90
ONGRID_ALERT_DISK_USED_PERCENT=90
ONGRID_ALERT_LOAD1=0
